use Drupal\Core\Form\FormStateInterface;
use Drupal\webform\WebformSubmissionInterface;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\ReplaceCommand;

/**
 * @file
 * Primary module hooks for prodepem_solicitudes_rtm module.
 */


/**
 * Implements hook_webform_element_alter().
 */
function prodepem_solicitudes_rtm_webform_element_alter(array &$element, FormStateInterface $form_state, array $context) {
    $key = $element['#webform_key'] ?? NULL;

    // Set default value for 'fecha_convenio'.
    if ($key === 'fecha_convenio') {
      $element['#default_value'] = date('Y-m-d');
    }

    // AJAX for 'codigo_de_verificacion'.
    if ($key === 'codigo_de_verificacion') {
      $element['#ajax'] = [
        'callback' => 'prodepem_solicitudes_rtm_verificacion_otp_callback',
        'wrapper' => 'validacion-otp-wrapper',
        'event' => 'change',
      ];
    }

    // Wrapper and logic for 'validacion_otp'.
    if ($key === 'validacion_otp_result') {
      $element['#prefix'] = '<div id="validacion-otp-wrapper">';
      $element['#suffix'] = '</div>';

      $code = $form_state->getValue('codigo_de_verificacion');
      if ($code == '1234') {
        $element['#value'] = 1;
      }
    }


    // AJAX for 'departamento'.
    if ($key === 'departamento') {
      $element['#ajax'] = [
        'callback' => 'prodepem_solicitudes_rtm_ubicacion_cda_callback',
        'wrapper' => 'ubicacion-cda-wrapper',
        'event' => 'change',
      ];
    }

    // AJAX for 'ubicacion_cda' and Wrapper for 'ubicacion_cda'.
    if ($key === 'ubicacion_cda') {
      $element['#ajax'] = [
        'callback' => 'prodepem_solicitudes_rtm_cda_callback',
        'wrapper' => 'cda-wrapper',
        'event' => 'change',
      ];
      $element['#prefix'] = '<div id="ubicacion-cda-wrapper">';
      $element['#suffix'] = '</div>';

      // Filter options based on 'departamento'.
      $departamento_tid = $form_state->getValue('departamento');
      if ($departamento_tid) {
        $options = [];
        /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
        $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
        $terms = $term_storage->loadChildren($departamento_tid);
        foreach ($terms as $term) {
          $options[$term->id()] = $term->label();
        }
        $element['#options'] = $options;
      }
      else {
        $element['#options'] = [];
      }
    }

    // Wrapper and options for 'cda'.
    if ($key === 'cda') {
      $element['#prefix'] = '<div id="cda-wrapper">';
      $element['#suffix'] = '</div>';

      // Filter options based on 'ubicacion_cda'.
      $ubicacion_tid = $form_state->getValue('ubicacion_cda');
      if ($ubicacion_tid) {
        $options = [];
        $query = \Drupal::entityQuery('taxonomy_term')
          ->condition('vid', 'cdas')
          ->condition('field_ciudad', $ubicacion_tid)
          ->accessCheck(FALSE);
        $tids = $query->execute();

        if (!empty($tids)) {
          $terms = \Drupal\taxonomy\Entity\Term::loadMultiple($tids);
          foreach ($terms as $term) {
            $options[$term->id()] = $term->label();
          }
          $element['#options'] = $options;
        }
        else {
          $element['#options'] = [];
        }
      }
      else {
        $element['#options'] = [];
      }
    }

    // Wrapper and logic for 'detalles_cda'.
    if ($key === 'detalles_cda') {
      $element['#prefix'] = '<div id="detalles-cda-wrapper">';
      $element['#suffix'] = '</div>';
    }
  
}

/**
 * Implements hook_form_alter().
 */
function prodepem_solicitudes_rtm_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Check if the form is the add form for 'solicitud_de_revision_tecnico_me'.
  if ($form_id === 'webform_submission_solicitud_de_revision_tecnico_me_add_form') {
    // Attach the library.
    $form['#attached']['library'][] = 'prodepem_solicitudes_rtm/prodepem_solicitudes_rtm';
  }

  // Check if the form is the add form for 'formulario_touch'.
  if ($form_id === 'webform_submission_formulario_touch_add_form') {
    // Attach the custom library.
    $form['#attached']['library'][] = 'prodepem_solicitudes_rtm/formulario_touch';

    // Add custom validation handler.
    $form['#validate'][] = 'prodepem_solicitudes_rtm_formulario_touch_validate';

    // Map of element keys to icons.
    $icons = [
      'nombre' => 'fa-user',
      'apellidos' => 'fa-user',
      'email' => 'fa-envelope',
      'telefono' => 'fa-phone',
      'mensaje' => 'fa-comment',
      'empresa' => 'fa-building',
      'cargo' => 'fa-id-badge',
      'ciudad' => 'fa-city',
      'asunto' => 'fa-heading',
      'tipo_de_vehiculo' => 'fa-car',
      'celular' => 'fa-mobile-alt',
      'tipo_de_documento' => 'fa-question-circle',
      'que_tipo_de_producto_o_servicio_desea_adquirir' => 'fa-question-circle',
      'numero_de_documento' => 'fa-id-card',
      'placa_vehiculo' => 'fa-hashtag',
      'sector' => 'fa-building',
    ];

    // Add icons to labels.
    foreach ($icons as $key => $icon) {
      if (isset($form['elements'][$key])) {
        $title = $form['elements'][$key]['#title'] ?? '';
        $form['elements'][$key]['#title'] = \Drupal\Core\Render\Markup::create('<i class="fas ' . $icon . '"></i> ' . $title);
      }
    }
  }

  // Check if the form is for 'formulario_equidad_seguros'.
  $is_equidad_form = (
    $form_id === 'webform_submission_formulario_equidad_seguros_add_form' ||
    strpos($form_id, 'webform_submission_formulario_equidad_seguros') === 0 ||
    (isset($form['#webform_id']) && $form['#webform_id'] === 'formulario_equidad_seguros')
  );
  if ($is_equidad_form) {
    // Attach custom library for styles and gestures.
    $form['#attached']['library'][] = 'prodepem_solicitudes_rtm/formulario_equidad_seguros';

    // Clases CSS personalizadas o atributos para ajustes de estilo.
    $form['#attributes']['class'][] = 'formulario-equidad-seguros';

    // Desactivar input de cantidad adicional y texto 'more items' en elementos m?ltiples.
    $disable_add_more = function (&$elements) use (&$disable_add_more) {
      foreach ($elements as $key => &$child) {
        if (is_array($child) && strpos((string) $key, '#') !== 0) {
          if (isset($child['#type']) && in_array($child['#type'], ['webform_multiple', 'webform_custom_composite'])) {
            $child['#add_more_input'] = FALSE;
          }
          $disable_add_more($child);
        }
      }
    };
    if (isset($form['elements'])) {
      $disable_add_more($form['elements']);
    }

    // Homologar estilo de '?Est? interesado en otros productos?' al estilo de 'Seguros adicionales'.
    $apply_style_interesado = function (&$elements) use (&$apply_style_interesado) {
      foreach ($elements as $key => &$child) {
        if (is_array($child) && strpos((string) $key, '#') !== 0) {
          $title = (string) ($child['#title'] ?? '');
          if (mb_stripos($title, 'interesado en otros productos') !== FALSE) {
            $child['#attributes']['class'][] = 'estilo-seguros-adicionales';
            $child['#wrapper_attributes']['class'][] = 'wrapper-estilo-seguros-adicionales';
            $child['#label_attributes']['class'][] = 'label-estilo-seguros-adicionales';
          }
          $apply_style_interesado($child);
        }
      }
    };
    if (isset($form['elements'])) {
      $apply_style_interesado($form['elements']);
    }

    // Pre-llenar datos de ASPU en los campos del tomador si selector_tomador es 2 (por defecto).
    $aspu_tomador_data = [
      'tomador' => 'Asociación Sindical de Profesores Universitarios - ASPU',
      'c_c_nit' => '830001998',
      'nit_tomador' => '830001998',
      'direccion' => 'Cra 6 # 77-305',
      'direccion_tomador' => 'Cra 6 # 77-305',
      'ciudad' => 'Montería',
      'ciudad_tomador' => 'Montería',
      'telefono' => '3242560489',
      'telefono_tomador' => '3242560489',
    ];

    $set_tomador_defaults = function (&$elements) use (&$set_tomador_defaults, $aspu_tomador_data) {
      foreach ($elements as $key => &$child) {
        if (is_array($child) && strpos((string) $key, '#') !== 0) {
          if ($key === 'selector_tomador' && empty($child['#default_value'])) {
            $child['#default_value'] = '2';
          }
          if (isset($aspu_tomador_data[$key])) {
            if (!isset($child['#default_value']) || $child['#default_value'] === '') {
              $child['#default_value'] = $aspu_tomador_data[$key];
            }
          }
          $set_tomador_defaults($child);
        }
      }
    };
    if (isset($form['elements'])) {
      $set_tomador_defaults($form['elements']);
    }


  }
}

/**
 * AJAX callback for CDA options.
 */
function prodepem_solicitudes_rtm_cda_callback(array &$form, FormStateInterface $form_state) {
    // Helper to find element by key recursively.
    $find_element = function (array &$elements, $key) use (&$find_element) {
      if (isset($elements[$key])) {
        return $elements[$key];
      }
      foreach ($elements as &$element) {
        if (is_array($element) && strpos($key, '#') !== 0) {
          $found = $find_element($element, $key);
          if ($found) {
            return $found;
          }
        }
      }
      return NULL;
    };

    return $find_element($form['elements'], 'cda');
}

/**
 * AJAX callback for Ubicacion CDA options.
 */
function prodepem_solicitudes_rtm_ubicacion_cda_callback(array &$form, FormStateInterface $form_state) {
    // Helper to find element by key recursively.
    $find_element = function (array &$elements, $key) use (&$find_element) {
      if (isset($elements[$key])) {
        return $elements[$key];
      }
      foreach ($elements as &$element) {
        if (is_array($element) && strpos($key, '#') !== 0) {
          $found = $find_element($element, $key);
          if ($found) {
            return $found;
          }
        }
      }
      return NULL;
    };

    return $find_element($form['elements'], 'ubicacion_cda');
}


/**
 * Implements hook_webform_submission_presave().
 */
function prodepem_solicitudes_rtm_webform_submission_presave(WebformSubmissionInterface $webform_submission) {
  $data = $webform_submission->getData();
  $webform = $webform_submission->getWebform();
  $webform_id = $webform ? $webform->id() : '';

  // Formulario Equidad Seguros: Asignar automáticamente los datos del tomador según 'selector_tomador'.
  // Si selector_tomador es 2 (o por defecto en este formulario), corresponde a ASPU y se colocan sus datos en tomador, c_c_nit, direccion, ciudad, telefono.
  if ($webform_id === 'formulario_equidad_seguros' || isset($data['selector_tomador'])) {
    $selector = (string) ($data['selector_tomador'] ?? '2');
    if ($selector === '2' || $selector === 'aspu') {
      $data['selector_tomador'] = '2';
      $data['tomador'] = 'Asociación Sindical de Profesores Universitarios - ASPU';
      $data['c_c_nit'] = '830001998';
      $data['nit_tomador'] = '830001998';
      $data['direccion'] = 'Cra 6 # 77-305';
      $data['direccion_tomador'] = 'Cra 6 # 77-305';
      $data['ciudad'] = 'Montería';
      $data['ciudad_tomador'] = 'Montería';
      $data['telefono'] = '3242560489';
      $data['telefono_tomador'] = '3242560489';
      $webform_submission->setData($data);
    }
    elseif ($selector === '1' || $selector === 'foneducor') {
      $data['selector_tomador'] = '1';
      $data['tomador'] = 'Fondo de empleado de docente de la Universidad de Córdoba';
      $data['c_c_nit'] = '900834726';
      $data['nit_tomador'] = '900834726';
      $data['direccion'] = 'Cra 6 # 76-103';
      $data['direccion_tomador'] = 'Cra 6 # 76-103';
      $data['ciudad'] = 'Montería';
      $data['ciudad_tomador'] = 'Montería';
      $data['telefono'] = '3014619585';
      $data['telefono_tomador'] = '3014619585';
      $webform_submission->setData($data);
    }
  }

  // Check if the webform is 'solicitud_de_revision_tecnico_me'.
  if ($webform_submission->getWebform()->id() === 'solicitud_de_revision_tecnico_me') {
    $data = $webform_submission->getData();
    // Get 'entidad_convenio' value.
    if (!empty($data['entidad_convenio'])) {
      $tid = $data['entidad_convenio'];
      $term = \Drupal\taxonomy\Entity\Term::load($tid);
      if ($term && $term->hasField('field_correo_convenio') && !$term->get('field_correo_convenio')->isEmpty()) {
        // Set 'email_convenio' value.
        $email = $term->get('field_correo_convenio')->value;
        $data['email_convenio'] = $email;
        $webform_submission->setData($data);
      }
    }

    // Get 'cda' value.
    if (!empty($data['cda'])) {
      $tid = $data['cda'];
      $term = \Drupal\taxonomy\Entity\Term::load($tid);
      if ($term && $term->hasField('field_email_cda') && !$term->get('field_email_cda')->isEmpty()) {
        // Set 'email_cda' value.
        $email = $term->get('field_email_cda')->value;
        $data['email_cda'] = $email;
        $webform_submission->setData($data);
      }
    }
  }
}

/**
 * AJAX callback for Verification OTP.
 */
function prodepem_solicitudes_rtm_verificacion_otp_callback(array &$form, FormStateInterface $form_state) {
  $response = new AjaxResponse();

  // Helper to find element by key recursively.
  $find_element = function (array &$elements, $key) use (&$find_element) {
    if (isset($elements[$key])) {
      return $elements[$key];
    }
    foreach ($elements as &$element) {
      if (is_array($element) && strpos($key, '#') !== 0) {
        $found = $find_element($element, $key);
        if ($found) {
          return $found;
        }
      }
    }
    return NULL;
  };


  $otp_element = $find_element($form['elements'], 'validacion_otp_result');
  if ($otp_element) {
    $response->addCommand(new ReplaceCommand('#validacion-otp-wrapper', $otp_element));
  }



  return $response;
}

/**
 * Custom validation for formulario_touch OTP.
 */
function prodepem_solicitudes_rtm_formulario_touch_validate(&$form, FormStateInterface $form_state) {
  $values = $form_state->getValues();
  $otp_result = $values['validacion_otp_result'] ?? NULL;

  if ($otp_result != 1) {
    $form_state->setErrorByName('codigo_de_verificacion', t('No se pudo validar el numero de telefono del cliente'));
  }
}
