{#
/**
 * @file
 * Template for Reportes de Equidad Seguros - Panel Central.
 *
 * Variables:
 * - stats: Array con total, aspu y foneducor.
 */
#}
<div class="reportes-equidad-container">
  <div class="reportes-header">
    <div>
      <h2 class="reportes-header__title">
        <i class="fa-solid fa-shield-halved" style="color: #15803d;"></i>
        {{ 'Reportes de Equidad Seguros'|t }}
      </h2>
      <p class="reportes-header__desc">
        {{ 'Gestión consolidada de respuestas del formulario de asegurabilidad para ASPU y FONEDUCOR con filtros, visualización de sumisiones y exportación a Excel.'|t }}
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <a href="/admin/config/prodepem/rtm-admin" class="btn-reporte btn-reporte--secondary">
        <i class="fa-solid fa-arrow-left"></i> {{ 'Volver a RTM Admin'|t }}
      </a>
    </div>
  </div>

  <!-- Estadísticas Rápidas -->
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <div style="flex: 1; min-width: 200px; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1.15rem 1.25rem;">
      <div style="font-size: 0.8rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">{{ 'Total Solicitudes'|t }}</div>
      <div style="font-size: 1.85rem; font-weight: 800; color: #111827; margin-top: 0.2rem;">{{ stats.total|default(0) }}</div>
    </div>
    <div style="flex: 1; min-width: 200px; background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 10px; padding: 1.15rem 1.25rem;">
      <div style="font-size: 0.8rem; font-weight: 600; color: #7c3aed; text-transform: uppercase;">{{ 'Tomador ASPU'|t }}</div>
      <div style="font-size: 1.85rem; font-weight: 800; color: #5b21b6; margin-top: 0.2rem;">{{ stats.aspu|default(0) }}</div>
    </div>
    <div style="flex: 1; min-width: 200px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 1.15rem 1.25rem;">
      <div style="font-size: 0.8rem; font-weight: 600; color: #16a34a; text-transform: uppercase;">{{ 'Tomador FONEDUCOR'|t }}</div>
      <div style="font-size: 1.85rem; font-weight: 800; color: #065f46; margin-top: 0.2rem;">{{ stats.foneducor|default(0) }}</div>
    </div>
  </div>

  <!-- Grid de 4 Reportes -->
  <div class="reportes-grid">
    <!-- Reporte 1: ASPU Seguro de Vida -->
    <div class="reportes-card">
      <div>
        <div class="reportes-card__icon" style="color: #6366f1;">
          <i class="fa-solid fa-file-shield"></i>
        </div>
        <span class="reportes-badge reportes-badge--aspu">ASPU</span>
        <h3 class="reportes-card__title" style="margin-top: 0.5rem;">{{ 'Reporte ASPU (Seguro de Vida)'|t }}</h3>
        <p class="reportes-card__desc">
          {{ 'Respuestas de declaración de asegurabilidad exclusivas para el tomador ASPU. Incluye datos personales, laborales, valor asegurado, beneficiarios y salud.'|t }}
        </p>
      </div>
      <div class="reportes-card__actions">
        <a href="{{ path('prodepem_solicitudes_rtm.reporte_aspu') }}" class="btn-reporte btn-reporte--primary btn-reporte--sm">
          <i class="fa-solid fa-table-list"></i> {{ 'Ver Reporte'|t }}
        </a>
        <a href="{{ path('prodepem_solicitudes_rtm.reportes_equidad_exportar', {'reporte': 'aspu'}) }}" class="btn-reporte btn-reporte--excel btn-reporte--sm">
          <i class="fa-solid fa-file-excel"></i> {{ 'Descargar XLS'|t }}
        </a>
      </div>
    </div>

    <!-- Reporte 2: FONEDUCOR Seguro de Vida -->
    <div class="reportes-card">
      <div>
        <div class="reportes-card__icon" style="color: #059669;">
          <i class="fa-solid fa-file-signature"></i>
        </div>
        <span class="reportes-badge reportes-badge--foneducor">FONEDUCOR</span>
        <h3 class="reportes-card__title" style="margin-top: 0.5rem;">{{ 'Reporte FONEDUCOR (Seguro de Vida)'|t }}</h3>
        <p class="reportes-card__desc">
          {{ 'Respuestas de declaración de asegurabilidad exclusivas para FONEDUCOR (Fondo de Empleados Docentes Universidad de Córdoba).'|t }}
        </p>
      </div>
      <div class="reportes-card__actions">
        <a href="{{ path('prodepem_solicitudes_rtm.reporte_foneducor') }}" class="btn-reporte btn-reporte--primary btn-reporte--sm">
          <i class="fa-solid fa-table-list"></i> {{ 'Ver Reporte'|t }}
        </a>
        <a href="{{ path('prodepem_solicitudes_rtm.reportes_equidad_exportar', {'reporte': 'foneducor'}) }}" class="btn-reporte btn-reporte--excel btn-reporte--sm">
          <i class="fa-solid fa-file-excel"></i> {{ 'Descargar XLS'|t }}
        </a>
      </div>
    </div>

    <!-- Reporte 3: ASPU Adicionales & Rifa -->
    <div class="reportes-card">
      <div>
        <div class="reportes-card__icon" style="color: #8b5cf6;">
          <i class="fa-solid fa-ticket"></i>
        </div>
        <span class="reportes-badge reportes-badge--aspu">ASPU • Datos Complementarios</span>
        <h3 class="reportes-card__title" style="margin-top: 0.5rem;">{{ 'Reporte ASPU (Datos Complementarios)'|t }}</h3>
        <p class="reportes-card__desc">
          {{ 'Datos comerciales complementarios: ampliar amparo de vida y motivo, seguros de interés (SOAT, todo riesgo, hogar, adicionales), placa y números de rifa.'|t }}
        </p>
      </div>
      <div class="reportes-card__actions">
        <a href="{{ path('prodepem_solicitudes_rtm.reporte_aspu_adicionales') }}" class="btn-reporte btn-reporte--primary btn-reporte--sm">
          <i class="fa-solid fa-table-list"></i> {{ 'Ver Reporte'|t }}
        </a>
        <a href="{{ path('prodepem_solicitudes_rtm.reportes_equidad_exportar', {'reporte': 'aspu-adicionales'}) }}" class="btn-reporte btn-reporte--excel btn-reporte--sm">
          <i class="fa-solid fa-file-excel"></i> {{ 'Descargar XLS'|t }}
        </a>
      </div>
    </div>

    <!-- Reporte 4: FONEDUCOR Adicionales & Rifa -->
    <div class="reportes-card">
      <div>
        <div class="reportes-card__icon" style="color: #10b981;">
          <i class="fa-solid fa-gift"></i>
        </div>
        <span class="reportes-badge reportes-badge--foneducor">FONEDUCOR • Datos Complementarios</span>
        <h3 class="reportes-card__title" style="margin-top: 0.5rem;">{{ 'Reporte FONEDUCOR (Datos Complementarios)'|t }}</h3>
        <p class="reportes-card__desc">
          {{ 'Datos comerciales complementarios: ampliar amparo de vida y motivo, seguros de interés (SOAT, todo riesgo, hogar, adicionales), placa y números de rifa (FONEDUCOR).'|t }}
        </p>
      </div>
      <div class="reportes-card__actions">
        <a href="{{ path('prodepem_solicitudes_rtm.reporte_foneducor_adicionales') }}" class="btn-reporte btn-reporte--primary btn-reporte--sm">
          <i class="fa-solid fa-table-list"></i> {{ 'Ver Reporte'|t }}
        </a>
        <a href="{{ path('prodepem_solicitudes_rtm.reportes_equidad_exportar', {'reporte': 'foneducor-adicionales'}) }}" class="btn-reporte btn-reporte--excel btn-reporte--sm">
          <i class="fa-solid fa-file-excel"></i> {{ 'Descargar XLS'|t }}
        </a>
      </div>
    </div>
  </div>
</div>
