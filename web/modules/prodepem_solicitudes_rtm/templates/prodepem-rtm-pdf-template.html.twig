<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{ 'Solicitud RTM'|t }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.6;
            color: #333;
        }
        .header {
            border-bottom: 2px solid #0056b3;
            margin-bottom: 20px;
            padding-bottom: 10px;
            width: 100%;
        }
        .header table {
            width: 100%;
            border-collapse: collapse;
        }
        .header .logo-cell {
            width: 150px;
            vertical-align: middle;
        }
        .header .logo-cell img {
            max-width: 150px;
            height: auto;
        }
        .header .title-cell {
            text-align: center;
            vertical-align: middle;
        }
        .header h1 {
            margin: 0;
            color: #0056b3;
            font-size: 20px;
        }
        .header p {
            margin: 5px 0 0 0;
            font-size: 11px;
        }
        .section {
            margin-bottom: 20px;
        }
        .section-title {
            font-weight: bold;
            text-transform: uppercase;
            background-color: #f2f2f2;
            padding: 5px;
            border-left: 5px solid #0056b3;
            margin-bottom: 10px;
        }
        .field-group {
            display: table;
            width: 100%;
            margin-bottom: 5px;
        }
        .field-label {
            display: table-cell;
            font-weight: bold;
            width: 40%;
            border-bottom: 1px dotted #ccc;
        }
        .field-value {
            display: table-cell;
            width: 60%;
            border-bottom: 1px dotted #ccc;
        }
        .field-value-html {
            padding: 10px;
            border: 1px solid #eee;
            background-color: #fafafa;
        }
        .footer {
            margin-top: 50px;
            text-align: center;
            font-size: 10px;
            color: #777;
        }
    </style>
</head>
<body>
    <div class="header">
        <table>
            <tr>
                <td class="logo-cell">
                    {% if logo_path %}
                        <img src="{{ logo_path }}" alt="Logo Prodepem">
                    {% endif %}
                </td>
                <td class="title-cell">
                    <h1>{{ 'PRODEPEM - SOLICITUD RTM'|t }}</h1>
                    <p>{{ 'Fecha de solicitud:'|t }} {{ data.fecha_convenio|default('N/A') }} | {{ 'Consecutivo:'|t }} TM-{{ serial|trim }}</p>
                </td>
            </tr>
        </table>
    </div>

    <div class="section">
        <div class="section-title">{{ 'Información General'|t }}</div>

        <div class="field-group">
            <div class="field-label">{{ 'Placa del Vehículo:'|t }}</div>
            <div class="field-value">{{ data.placa_vehiculo|default('N/A') }}</div>
        </div>
        
        <div class="field-group">
            <div class="field-label">{{ 'Nombre:'|t }}</div>
            <div class="field-value">{{ data.nombre_completo|default('N/A') }}</div>
        </div>
        
       

        <div class="field-group">
            <div class="field-label">{{ 'CDA:'|t }}</div>
            <div class="field-value">{{ data.cda_label|default('N/A') }}</div>
        </div>

        <div class="field-group">
            <div class="field-label">{{ 'Entidad Convenio:'|t }}</div>
            <div class="field-value">{{ data.entidad_convenio_label|default('N/A') }}</div>
        </div>

        <div class="field-group">
            <div class="field-label">{{ 'Fecha Solicitud:'|t }}</div>
            <div class="field-value">{{ data.fecha_convenio|default('N/A') }}</div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">{{ 'Datos del CDA'|t }}</div>

        <div class="field-group">
            <div class="field-label">{{ 'CDA:'|t }}</div>
            <div class="field-value">{{ data.cda_label|default('N/A') }}</div>
        </div>
        
        <div class="field-group">
            <div class="field-label">{{ 'Departamento:'|t }}</div>
            <div class="field-value">{{ data.departamento_label|default('N/A') }}</div>
        </div>
        
        <div class="field-group">
            <div class="field-label">{{ 'Ciudad:'|t }}</div>
            <div class="field-value">{{ data.ubicacion_cda_label|default('N/A') }}</div>
        </div>
        <div class="field-group">
            <div class="field-label">{{ 'Dirección:'|t }}</div>
            <div class="field-value">{{ data.cda_direccion|default('N/A') }}</div>
        </div>
        <div class="field-group">
            <div class="field-label">{{ 'Teléfono:'|t }}</div>
            <div class="field-value">{{ data.cda_telefono|default('N/A') }}</div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">{{ 'Detalles del CDA'|t }}</div>
        <div class="field-value-html">
            {{ data.detalles_cda|raw }}
        </div>
    </div>

    <div class="footer">
        <p>&copy; {{ "now"|date("Y") }} Prodepem - {{ 'Documento generado automáticamente'|t }}</p>
    </div>
</body>
</html>
